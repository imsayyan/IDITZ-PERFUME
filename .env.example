# ===================================================================
# IDITZ PERFUME — Production Environment Variables Reference
# ===================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Security (Generate a secure 64-character random string)
JWT_SECRET=iditz_luxury_perfumes_super_secure_jwt_token_2026_change_me

# Client Domain / CORS (Use * or your production domain https://iditzperfume.com)
CLIENT_URL=*

# Persistent Storage Paths (Set if mounting a cloud volume on Render/Railway)
# If using a persistent volume at /data:
# DB_PATH=/data/noore.db
# UPLOADS_PATH=/data/uploads
# Default local/unmounted fallback:
DB_PATH=./backend/data/noore.db
UPLOADS_PATH=./backend/uploads

# Payment Gateway (Razorpay / Cashfree)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=rzp_live_your_actual_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_actual_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_actual_webhook_secret
